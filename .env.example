# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3000

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Static API key - set a strong random string in production
API_KEY=your-secret-api-key-here

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Use resend sandbox: onboarding@resend.dev (no domain needed for testing)
EMAIL_FROM=onboarding@resend.dev

# ─── WhatsApp (Baileys) ───────────────────────────────────────────────────────
# Baileys uses QR scan auth - no token needed here
# Session will be saved to ./baileys_auth_info/
